#!/bin/sh
# =============================================================================
#  pre-commit —— 拦截"超大代码文件"
# -----------------------------------------------------------------------------
#  规则
#    · 只检查代码文件（按扩展名白名单），图片 / 字体 / PDF / 数据文件不受影响
#    · 单个文件超过阈值（默认 20 KB = 20480 字节）即拦截本次提交
#    · 自动放行：lockfile、压缩产物、类型声明、构建/依赖目录、
#      带 "@generated / DO NOT EDIT" 标记的文件、.gitattributes 里
#      标了 linguist-generated 的文件
#    · 被拦时打印按功能拆分的建议 + 绕过方式
#
#  配置（在仓库根目录执行）
#    git config hooks.maxFileSizeKB 40                          改阈值
#    git config --add hooks.sizeCheck.exclude 'src/legacy/*'    永久放行某路径
#    git config hooks.sizeCheck.disabled true                   整体关闭
#
#  临时绕过
#    SKIP_SIZE_CHECK=1 git commit -m "..."    只跳体积检查
#    git commit --no-verify                   跳所有钩子
#
#  依赖：仅 git + POSIX sh（Windows 下由 Git for Windows 的 sh 执行）
# =============================================================================

set -u

DEFAULT_MAX_KB=20

# ---------------------------------------------------------------- 0. 开关
if [ "${SKIP_SIZE_CHECK:-0}" = "1" ]; then
    printf '[pre-commit] SKIP_SIZE_CHECK=1，已跳过文件体积检查\n' >&2
    exit 0
fi

if [ "$(git config --bool hooks.sizeCheck.disabled 2>/dev/null || true)" = "true" ]; then
    exit 0
fi

max_kb=$(git config --int --get hooks.maxFileSizeKB 2>/dev/null || true)
[ -n "${max_kb:-}" ] || max_kb=$DEFAULT_MAX_KB
[ "$max_kb" -gt 0 ] 2>/dev/null || exit 0
max_bytes=$((max_kb * 1024))

extra_excludes=$(git config --get-all hooks.sizeCheck.exclude 2>/dev/null || true)

staged=$(git diff --cached --name-only --diff-filter=ACM 2>/dev/null || true)
[ -n "$staged" ] || exit 0

count=0

# ---------------------------------------------------------------- 1. 遍历暂存文件
while IFS= read -r path; do
    [ -n "$path" ] || continue

    # --- 1.1 只认代码文件 ---
    case "$path" in
        *.c|*.h|*.cc|*.cpp|*.cxx|*.hpp|*.hh|*.hxx|*.ino|*.pde|\
        *.cs|*.java|*.kt|*.kts|*.scala|*.groovy|\
        *.py|*.pyi|*.pyx|*.js|*.jsx|*.mjs|*.cjs|*.ts|*.tsx|\
        *.go|*.rs|*.rb|*.php|*.swift|*.m|*.mm|*.dart|\
        *.lua|*.sh|*.bash|*.zsh|*.ps1|*.psm1|*.bat|*.cmd|\
        *.sql|*.jl|*.ex|*.exs|*.erl|*.hrl|*.hs|*.lhs|\
        *.clj|*.cljs|*.cljc|*.ml|*.mli|*.fs|*.fsi|*.vb|\
        *.asm|*.s|*.S|*.v|*.sv|*.svh|*.vhd|*.vhdl|\
        *.zig|*.nim|*.d|*.cr|*.elm|*.lisp|*.scm|*.rkt|\
        *.vue|*.svelte|*.astro|*.css|*.scss|*.sass|*.less|*.html|*.htm)
            ;;
        *)
            continue
            ;;
    esac

    base=${path##*/}

    # --- 1.2 文件名级放行：lockfile / 压缩产物 / 声明文件 ---
    case "$base" in
        package-lock.json|npm-shrinkwrap.json|yarn.lock|pnpm-lock.yaml|\
        pnpm-workspace.yaml|bun.lock|bun.lockb|Cargo.lock|poetry.lock|\
        Pipfile.lock|uv.lock|pdm.lock|composer.lock|Gemfile.lock|go.sum|\
        mix.lock|pubspec.lock|Podfile.lock|carton.lock|packages.lock.json|\
        flake.lock|*.lock|*.lockb|*-lock.json|\
        *.min.js|*.min.css|*.min.mjs|*.min.scss|*.map|\
        *.d.ts|*.pb.go|*.pb.cc|*.pb.h|*_pb2.py|*_pb2_grpc.py|\
        *.g.dart|*.freezed.dart|*.designer.cs|*.generated.*|*_generated.*)
            continue
            ;;
    esac

    # --- 1.3 目录级放行：依赖 / 构建产物 / 生成代码目录 ---
    case "/$path" in
        */node_modules/*|*/vendor/*|*/third_party/*|*/thirdparty/*|\
        */external/*|*/deps/*|*/dist/*|*/build/*|*/out/*|*/output/*|\
        */coverage/*|*/target/*|*/obj/*|*/Debug/*|*/Release/*|\
        */.next/*|*/.nuxt/*|*/.svelte-kit/*|*/.gradle/*|\
        */generated/*|*/__generated__/*|*/gen/*|*/.venv/*|*/venv/*|\
        */site-packages/*)
            continue
            ;;
    esac

    # --- 1.4 用户自定义放行（git config --add hooks.sizeCheck.exclude）---
    if [ -n "${extra_excludes:-}" ]; then
        old_ifs=$IFS
        IFS='
'
        skip=0
        for pat in $extra_excludes; do
            [ -n "$pat" ] || continue
            case "/$path" in
                $pat) skip=1; break ;;
                *"$pat"*) skip=1; break ;;
            esac
        done
        IFS=$old_ifs
        [ "$skip" = "1" ] && continue
    fi

    # --- 1.5 取暂存区里的 blob 大小（不是工作区文件大小）---
    info=$(git ls-files -s -- "$path" 2>/dev/null)
    info=${info%%'
'*}
    [ -n "$info" ] || continue
    mode=${info%% *}
    rest=${info#* }
    sha=${rest%% *}
    [ "$mode" = "160000" ] && continue            # 子模块
    size=$(git cat-file -s "$sha" 2>/dev/null || echo 0)
    [ "$size" -gt "$max_bytes" ] 2>/dev/null || continue

    # --- 1.6 .gitattributes: linguist-generated=true 视为生成物 ---
    attr=$(git check-attr linguist-generated -- "$path" 2>/dev/null || true)
    case "$attr" in
        *": set"*|*": true"*) continue ;;
    esac

    # --- 1.7 文件头里的"自动生成"标记 ---
    if git grep --cached -qiE -e '@generated|do not edit|do not modify|code generated by|generated automatically|auto-?generated|this file is generated|自动生成|不要手动修改' -- "$path" 2>/dev/null; then
        continue
    fi

    # --- 1.8 记录违规 ---
    count=$((count + 1))
    tenths=$((size * 10 / 1024))
    kb="$((tenths / 10)).$((tenths % 10))"
    if [ "$count" -eq 1 ]; then
        printf '\n[pre-commit] 检测到超过 %s KB 的代码文件：\n\n' "$max_kb" >&2
    fi
    printf '  %7s KB   %s\n' "$kb" "$path" >&2
done <<EOF
$staged
EOF

[ "$count" -gt 0 ] || exit 0

# ---------------------------------------------------------------- 2. 报错说明
cat >&2 <<EOF

-------------------------------------------------------------------------------
共 $count 个文件被拦截（阈值 ${max_kb} KB）。大文件的问题不是占硬盘，而是：
  · diff / review 基本读不下去，改一行要翻半天
  · 编辑器、代码检索、AI 辅助都得整块载入，上下文被一个文件吃光
  · 一个文件能长到 ${max_kb} KB，通常说明它同时干了三件以上的事

按功能拆分（不是按行数硬切）：
  1. 一个文件 = 一类职责：读数据 / 算逻辑 / 渲染输出，各拆一个
  2. 常量表、映射表、mock 数据   -> 抽到 data/ 或 *.constants.*
  3. 类型、接口、schema          -> 抽到 types.*
  4. 长函数按「解析 -> 处理 -> 落盘」分段，中间结果显式传参
  5. 复制粘贴的相似代码          -> 抽公共 util，别靠复制扩体积
  6. 机器生成的代码（protobuf / ORM / UI）-> 加 .gitattributes 标记后自动放行

确实要提交这一次：
  git commit --no-verify                    跳过全部钩子（含本检查）
  SKIP_SIZE_CHECK=1 git commit -m "..."     只跳过体积检查

永久放行某个路径：
  git config --add hooks.sizeCheck.exclude 'src/generated/*'

改阈值（0 = 关闭）：
  git config hooks.maxFileSizeKB 40

标记生成物（推荐，写进 .gitattributes 并提交，全队生效）：
  src/proto/*.pb.go linguist-generated=true
-------------------------------------------------------------------------------
EOF

exit 1
